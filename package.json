{
  "name": "ceo-ai-thailand",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json --noEmit && vite build && vite-node scripts/prerender-seo.mjs",
    "ci": "npm run lint && npm run build && npm run test:run",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:landed": "bash scripts/verify-landed.sh",
    "typecheck": "tsc -b && tsc -p tsconfig.worker.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "contrast-audit": "node scripts/contrast-audit.mjs"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.5",
    "@amplitude/plugin-session-replay-browser": "^1.33.7",
    "@supabase/supabase-js": "^2.108.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.8.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
