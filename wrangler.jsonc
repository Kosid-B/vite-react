{
  "name": "ceo-ai-thailand",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // 🔴 ห้ามลบ — ถ้าไม่มีบรรทัดนี้ Worker "ไม่ถูกเรียกเลย" ตอนคนเปิดหน้าเว็บ
    // เหตุผล: compatibility_date ของเรา (2026-06-11) ใหม่กว่า 2025-04-01 → flag
    //   `assets_navigation_prefers_asset_serving` เปิดโดยอัตโนมัติ = navigation request
    //   (Sec-Fetch-Mode: navigate) จะถูกเสิร์ฟด้วย index.html ก่อน "โดยไม่เรียก Worker"
    // ผลที่เคยเกิดจริง (พบ 17 ส.ค. 2569): ลิงก์สั้น /ราคา /ทุน /ลูกค้า ไม่ redirect,
    //   SEO ฝั่ง server ของ /start /sale /shop /legal /b/<slug> ไม่เคยทำงานเลยสักครั้ง
    // /* = ให้ Worker รันทุกเส้นทาง · ! = ยกเว้นไฟล์ static ที่ไม่ต้องผ่าน Worker (ประหยัด)
    "run_worker_first": ["/*", "!/assets/*", "!/fonts/*", "!/og/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CeoAiAgent",
        "class_name": "CeoAiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["CeoAiAgent"]
    }
  ],
  // Custom domain production — ผูกโดเมนกับ Worker (แทน A records → GitHub Pages ที่เป็น legacy)
  // custom_domain: true → Cloudflare สร้าง DNS + edge certificate ให้อัตโนมัติตอน deploy
  // (ต้องมีโซน ceoaithailand.org ในบัญชี Cloudflare เดียวกับ Worker — ดู docs/ops/GO-LIVE-CHECKLIST.md)
  // ⚠️ เจ้าของโดเมน = Cloudflare Worker เจ้าเดียว · Vercel = PR preview (*.vercel.app) เท่านั้น ห้ามผูก custom domain
  //    GitHub Pages = เลิกใช้ (ลบ public/CNAME แล้ว) · ดู docs/ops/DOMAIN-OWNERSHIP.md
  "routes": [
    { "pattern": "ceoaithailand.org", "custom_domain": true },
    { "pattern": "www.ceoaithailand.org", "custom_domain": true }
  ],
  "vars": {
    "ANTHROPIC_API_KEY": "",
    // ค่า public (ไม่ใช่ secret) — ใช้อ่านตาราง storefronts เพื่อทำ SEO ฝั่ง server (/b/<slug>, /sitemap.xml)
    // ใช้ publishable key (sb_publishable_…) = public โดยดีไซน์ + rotate แยกได้ (เลี่ยง anon JWT ที่ scanner ตีว่าเป็น secret)
    // production Supabase = waigsnxhrlwtiotspaim (ย้ายจาก rsjbqmnvocvtveelselj — ก.ค. 2569)
    "SUPABASE_URL": "https://waigsnxhrlwtiotspaim.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_Tf6Q7Mq6I2OLtfXot-EWJA_FESohA9E",
    "SITE_ORIGIN": "https://ceoaithailand.org",
    // โทเคนยืนยันความเป็นเจ้าของเว็บใน Google Search Console (ค่า public ไม่ใช่ secret)
    // ว่าง = ไม่แทรก meta ใด ๆ · วิธีเอาค่ามาใส่: docs/marketing/SEARCH-CONSOLE-SETUP.md
    "GOOGLE_SITE_VERIFICATION": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
